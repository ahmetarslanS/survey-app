# docker compose için ortam değişkenleri. Kopyalayıp doldurun:  cp .env.example .env
# Gerçek değerler yalnızca .env'e yazılır (git'e eklenmez); .env.example şablondur, ona gerçek değer yazmayın.

# Uygulamanın tarayıcıdan açıldığı adres; davet mailindeki linkler bununla kurulur
FRONTEND_URL=http://localhost
# Sunucuda dinlenecek port (TLS'i önde bir reverse proxy sonlandırıyorsa ör. 8081)
HTTP_PORT=80
# İmaj etiketi
APP_VERSION=latest

# --- Veritabanı ---
DB_NAME=dfx_survey_db
DB_USERNAME=dfx_user
DB_PASSWORD=
# update (önerilen) | validate | create (her açılışta veriyi siler)
DDL_AUTO=update

# --- Kimlik doğrulama ---
# En az 32 karakter rastgele değer, ör: openssl rand -base64 48
JWT_SECRET=
# DB'de hiç kullanıcı yokken ilk açılışta oluşturulan yönetici
ADMIN_EMAIL=admin@teamdefinex.com
ADMIN_PASSWORD=

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=developerschooldfx@gmail.com
# Gmail için hesap şifresi değil "uygulama şifresi". Davet mailleri her zaman SMTP ile gönderilir.
MAIL_PASSWORD=
